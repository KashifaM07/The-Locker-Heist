# Normalize line endings
* text=auto

# Exclude PowerShell test scripts from GitHub language statistics
*.ps1 linguist-vendored
*.ps1 linguist-documentation
*.ps1 -linguist-detectable
tests/* linguist-vendored
tests/* linguist-documentation
tests/* -linguist-detectable
tests/results/* linguist-vendored
tests/results/* linguist-documentation
tests/results/* -linguist-detectable
